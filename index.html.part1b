  position:relative;
  overflow:hidden;
  padding:0;
}
.scheme-tools{
  display:flex;align-items:center;flex-wrap:wrap;justify-content:flex-end;
  gap:.4rem .5rem;
  min-height:30px;
  padding:.4rem .75rem;
  border-bottom:1px solid var(--stage-border);
  background:var(--stage-inset);
}
.editor{
  display:grid;
  grid-template-columns:repeat(3,minmax(0,1fr));
  gap:.75rem 1rem;
  margin:0 0 14px;
}
.editor-stack{display:flex;flex-direction:column;gap:.35rem}
.editor-row{display:flex;align-items:center;gap:.3rem}
.editor-row input{
  flex:1;min-width:0;
  font-family:var(--font-mono);
  font-size:var(--type-mono-size);
  color:var(--ink);
  background:transparent;
  border:none;
  border-bottom:1.5px solid var(--line);
  border-radius:0;
  padding:.35rem 0;
  outline:none;
}
.editor-row input:focus{
  border-bottom-color:var(--ink);
  box-shadow:var(--edit-focus);
}
.editor-icon{
  font-family:var(--font-ui);font-size:.78rem;font-weight:500;
  color:var(--mute);background:transparent;border:none;
  padding:.35rem .45rem;min-width:2rem;min-height:36px;line-height:1;cursor:pointer;
}
.editor-icon:hover{color:var(--ink)}
.editor [data-add]{
  align-self:flex-start;
  padding:.35rem 0;
  min-height:36px;
}
.arrow-block .arrow-reagents,
.arrow-block .arrow-conditions{
  font-family:var(--font-scheme);
  font-size:var(--type-reagent-size);
  font-weight:var(--type-reagent-weight);
  line-height:var(--type-cond-line-height);
  text-align:center;
  color:var(--color-reagent);
  background:transparent;
  border:none;
  border-bottom:1.5px solid transparent;
  border-radius:0;
  padding:.15rem 0;
  width:100%;
  outline:none;
}
.arrow-block .arrow-conditions{
  font-size:var(--type-condition-below-size);
  font-weight:var(--type-condition-below-weight);
  color:var(--color-condition-below);
}
.arrow-block .arrow-reagents:focus,
.arrow-block .arrow-conditions:focus{
  border-bottom-color:var(--ink);
  box-shadow:var(--edit-focus);
}
.cta{
  font-family:var(--font-ui);font-size:.7rem;font-weight:500;
  letter-spacing:.02em;color:rgba(92,83,72,.72);
  background:transparent;border:1px solid rgba(26,21,16,.12);
  border-radius:999px;padding:.4rem .85rem;min-height:36px;height:36px;
  cursor:pointer;
}
.cta:hover:not(:disabled){color:var(--ink);border-color:rgba(26,21,16,.28)}
.cta:disabled{opacity:.45;cursor:not-allowed}
.scheme-scroll{overflow-x:auto;overflow-y:hidden;scrollbar-width:thin}
#scheme-stage{
  min-height:220px;
  padding:var(--space-plate-pad);
  background:transparent;
}
#scheme-stage.empty{
  display:flex;align-items:center;justify-content:center;
  color:rgba(92,83,72,.5);font-size:.84rem;min-height:200px;
  text-align:center;padding:1.5rem 1.25rem;
}
.scheme{
  display:flex;align-items:center;flex-wrap:nowrap;
  gap:var(--space-frag-gap);
  overflow-x:auto;
}
.species{display:flex;flex-direction:column;align-items:center}
.struct-slot{
  display:flex;align-items:center;justify-content:center;
  background:transparent;padding:0;
}
.struct-slot svg,.struct-slot canvas{display:block}
.struct-slot.label-only{
  min-width:7.5rem;padding:.4rem .2rem;
  font-family:var(--font-scheme);
  font-size:var(--type-scheme-label-size);
  font-weight:var(--type-scheme-label-weight);
  text-align:center;word-break:break-word;
  color:var(--ink);
}
.plus{
  font-family:var(--font-scheme);
  font-size:1.2rem;font-weight:400;color:var(--ink);
}
.arrow-block{
  display:flex;flex-direction:column;align-items:center;justify-content:center;
  gap:var(--space-cond-gap);padding:0 .15rem;
  min-width:var(--space-arrow-len);
}
.arrow-block .stack{
  display:flex;flex-direction:column;align-items:center;gap:var(--space-cond-gap);
  margin-bottom:var(--space-cond-above);
  font-family:var(--font-scheme);
  font-size:var(--type-reagent-size);
  font-weight:var(--type-reagent-weight);
  line-height:var(--type-cond-line-height);
  text-align:center;color:var(--color-reagent);
}
.arrow-block .stack.below{
  margin-bottom:0;
  margin-top:var(--space-cond-below);
  color:var(--color-condition-below);
  font-size:var(--type-condition-below-size);
  font-weight:var(--type-condition-below-weight);
}
.arrow-block svg{display:block;height:14px}
.actions{
  display:flex;flex-wrap:wrap;align-items:center;gap:.35rem .55rem;
  margin-top:16px;
}
#download-png{
  font-family:var(--font-ui);font-size:.88rem;font-weight:600;
  color:#fff;background:var(--copper);border:none;border-radius:999px;
  padding:.72rem 1.25rem;min-height:44px;cursor:pointer;
  box-shadow:0 4px 14px -6px rgba(196,92,38,.4);
}
#download-png:hover:not(:disabled){background:var(--copper-dim)}
#download-png:disabled{opacity:.5;cursor:not-allowed}
.ghost{
  font-family:var(--font-ui);font-size:.78rem;font-weight:500;
  color:var(--mute);background:transparent;border:none;
  padding:.55rem .35rem;min-height:44px;cursor:pointer;
}
.ghost:hover:not(:disabled){color:var(--ink)}
.ghost:disabled{opacity:.35;cursor:not-allowed}
.after{font-size:.78rem;color:var(--mute);margin-top:.85rem;max-width:42em}
footer{
  font-size:.62rem;color:rgba(92,83,72,.5);letter-spacing:.04em;margin-top:1.1rem;
}
@media(max-width:720px){
  .panel{padding:1.25rem 1.15rem 1.35rem;border-radius:16px}
  .brand img{height:30px}
  #download-png,.ghost,.cta{width:auto}
  .editor{grid-template-columns:1fr}
}
@media(prefers-reduced-motion:reduce){
  #download-png{transition:none}
}
</style>
</head>
