<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1"/>
<title>scheme 1 — Paste the reaction. Get the scheme.</title>
<meta name="description" content="Paste reaction text or SMILES, or drop ChemDraw .cdxml / .cdx. Draw a scheme. Download PNG or text-layout CDXML."/>
<link rel="icon" href="assets/brand/favicon.svg" type="image/svg+xml"/>
<link rel="apple-touch-icon" href="assets/brand/icon.svg"/>
<link rel="stylesheet" href="assets/tokens.css"/>
<link rel="preconnect" href="https://fonts.googleapis.com"/>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet"/>
<style>
:root{
  --line:rgba(26,21,16,.16);
  --hair:rgba(26,21,16,.08);
  --ok:var(--hood);
  --err:#8B2E1F;
  --font-body:var(--font-ui);
}
*{box-sizing:border-box;margin:0;padding:0}
html{color-scheme:light}
body{
  font-family:var(--font-ui);
  color:var(--ink);
  min-height:100vh;
  line-height:1.45;
  -webkit-font-smoothing:antialiased;
  background:var(--paper);
}
.atmosphere{
  position:fixed;inset:0;z-index:0;pointer-events:none;
  background:
    radial-gradient(ellipse 60% 55% at 8% 0%, rgba(196,92,38,.22) 0%, rgba(196,92,38,.06) 45%, transparent 70%),
    radial-gradient(ellipse 55% 50% at 100% 100%, rgba(31,107,90,.18) 0%, transparent 65%),
    radial-gradient(ellipse 45% 40% at 55% 30%, rgba(255,248,240,.5) 0%, transparent 70%),
    linear-gradient(135deg, #EFE6D8 0%, #F7F4EF 40%, #E4EBE6 100%);
}
.stage{
  position:relative;z-index:1;
  min-height:100vh;
  display:flex;align-items:center;justify-content:center;
  padding:clamp(1.5rem,4vw,3.5rem) clamp(1rem,3vw,2rem);
}
.panel{
  width:100%;max-width:960px;
  background:var(--chrome-bg);
  border:1px solid var(--hair);
  border-radius:20px;
  box-shadow:
    0 18px 48px -12px rgba(26,21,16,.10),
    0 4px 12px -4px rgba(26,21,16,.06),
    inset 0 1px 0 rgba(255,255,255,.7);
  padding:1.65rem 2rem 1.75rem;
}
.brand-row{
  display:flex;align-items:baseline;justify-content:space-between;
  gap:1rem;margin-bottom:.85rem;
}
.brand{display:inline-flex;align-items:center;line-height:0}
.brand img{display:block;height:34px;width:auto}
.lead{
  font-family:var(--font-ui);
  font-size:1.05rem;font-weight:400;letter-spacing:-.01em;
  color:var(--ink);margin:0 0 .7rem;line-height:1.3;
}
.panel-rule{
  height:0;border:none;border-top:1px solid var(--hair);
  margin:0 0 1rem;
}
label{display:flex;flex-direction:column;gap:.28rem}
.lbl{
  font-size:.62rem;font-weight:500;letter-spacing:.06em;text-transform:uppercase;
  color:rgba(92,83,72,.55);
}
.lbl .opt{font-weight:400;letter-spacing:.04em;text-transform:none;opacity:.7}
#reaction,#conditions{
  width:100%;
  font-family:var(--font-mono);
  font-size:var(--type-mono-size);color:var(--ink);line-height:1.45;
  caret-color:var(--ink);
  background:transparent;
  border:none;
  border-bottom:1.5px solid var(--line);
  border-radius:0;
  padding:.45rem 0 .5rem;
  outline:none;
}
#reaction{
  min-height:0;height:2.55rem;resize:none;overflow-y:hidden;
}
#conditions{min-height:0}
#reaction::placeholder,#conditions::placeholder{color:rgba(92,83,72,.58)}
#reaction:focus,#conditions:focus{
  border-bottom-color:var(--copper);
  box-shadow:var(--edit-focus);
}
.status{font-size:.78rem;min-height:1.2em;color:var(--mute);margin:.45rem 0 .2rem}
.status[data-state="ok"]{color:var(--ok)}
.status[data-state="error"]{color:var(--err)}
.drop{position:relative;display:flex;flex-direction:column;gap:.28rem;margin:.55rem 0 .15rem}
.drop-target{
  border:1px dashed var(--line);border-radius:10px;
  padding:.75rem .9rem;color:var(--mute);font-size:.84rem;
  cursor:pointer;background:transparent;
}
.drop-target:hover,.drop.over .drop-target{
  border-color:var(--ink);color:var(--ink);
}
.drop input{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)}
.extract{
  border:1px solid var(--hair);
  border-radius:10px;padding:.75rem .85rem;margin:.55rem 0 .15rem;
}
.extract[hidden]{display:none}
.extract-counts{font-size:.8rem;color:var(--ink);margin-bottom:.4rem}
.extract-species{
  display:flex;flex-wrap:wrap;gap:.3rem;
  list-style:none;margin:.1rem 0 .5rem;
}
.extract-species li{
  font-size:.72rem;font-weight:500;
  border:1px solid var(--line);border-radius:999px;
  padding:.18rem .5rem;background:transparent;
}
.atom-graph{display:block;width:100%;height:7.5rem;margin:.15rem 0 .5rem}
.extract details{font-size:.78rem;color:var(--mute)}
.extract summary{cursor:pointer;font-weight:500;color:var(--ink)}
.extract pre{
  margin-top:.4rem;font-size:.7rem;line-height:1.35;
  overflow:auto;max-height:14rem;white-space:pre-wrap;word-break:break-word;
  color:var(--mute);
}
.demos{margin:10px 0 14px}
.demo-label{
  font-size:.62rem;font-weight:500;letter-spacing:.06em;text-transform:uppercase;
  color:rgba(92,83,72,.55);margin-bottom:.4rem;
}
.demo-row{display:flex;flex-wrap:wrap;gap:.3rem .4rem;align-items:center}
.example{
  font-family:var(--font-ui);font-size:12.5px;font-weight:500;
  color:var(--mute);background:transparent;
  border:none;border-bottom:1.5px solid transparent;
  border-radius:0;padding:.55rem .45rem;min-height:44px;cursor:pointer;
}
.example:hover{color:var(--ink)}
.example.active{color:var(--ink);border-bottom-color:var(--ink)}
.scheme-stage{
